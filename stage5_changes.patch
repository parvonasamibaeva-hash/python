--- a/index.html
+++ b/index.html
@@ -1434,6 +1434,27 @@
 const lesson2TheoryHtml = "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Цифры, числа и типы данных — интерактивный урок</title>\n<style>\n  :root {\n    --ink: #182338;\n    --muted: #64748b;\n    --paper: #f5f7fb;\n    --card: #ffffff;\n    --blue: #3867f4;\n    --blue-soft: #e8efff;\n    --green: #15845b;\n    --green-soft: #e3f8ee;\n    --purple: #7c3aed;\n    --purple-soft: #f1eaff;\n    --orange: #c76b13;\n    --orange-soft: #fff0dc;\n    --line: #e5eaf2;\n    --shadow: 0 14px 35px rgba(30, 50, 90, .08);\n  }\n  * { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body {\n    margin: 0; background: var(--paper); color: var(--ink);\n    font-family: Inter, \"Segoe UI\", Arial, sans-serif; line-height: 1.6;\n  }\n  .hero {\n    background: radial-gradient(circle at 85% 15%, #6f8dff 0, transparent 28%),\n                linear-gradient(135deg, #172747, #263f75);\n    color: white; padding: 48px 22px 42px;\n  }\n  .hero-inner, main { max-width: 1050px; margin: 0 auto; }\n  .eyebrow { text-transform: uppercase; letter-spacing: .14em; font-size: .76rem; font-weight: 800; opacity: .8; }\n  h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.08; margin: 12px 0 16px; }\n  .hero p { max-width: 700px; font-size: 1.1rem; color: #e2eaff; margin: 0; }\n  .hero-pills { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 24px; }\n  .hero-pills span { padding: 7px 12px; border: 1px solid #ffffff40; background: #ffffff12; border-radius: 999px; font-size: .9rem; }\n  main { padding: 26px 18px 60px; }\n  .section { margin: 26px 0; scroll-margin-top: 20px; }\n  .section-head { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 16px; }\n  .num { display: grid; place-items: center; flex: 0 0 42px; height: 42px; border-radius: 14px; background: var(--blue-soft); color: var(--blue); font-weight: 900; }\n  h2 { font-size: clamp(1.35rem, 3vw, 1.8rem); line-height: 1.2; margin: 2px 0 6px; }\n  h3 { margin: 0 0 8px; font-size: 1.08rem; }\n  .sub { margin: 0; color: var(--muted); }\n  .card { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 22px; box-shadow: var(--shadow); }\n  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\n  .grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .digits { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 8px; margin: 18px 0; }\n  .digit {\n    border: 1px solid #dce5f7; background: #f7f9ff; color: #2449b8; border-radius: 12px;\n    min-height: 48px; font-size: 1.15rem; font-weight: 800; cursor: pointer; transition: .18s;\n  }\n  .digit:hover, .digit.active { background: var(--blue); color: white; transform: translateY(-2px); border-color: var(--blue); }\n  .notice { border-radius: 14px; background: #f0f5ff; padding: 13px 15px; color: #2b477d; }\n  .number-builder { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; }\n  .number-builder input { width: 100%; max-width: 230px; padding: 12px 14px; border: 1px solid #cfd9eb; border-radius: 12px; font: inherit; font-size: 1.1rem; }\n  button { font: inherit; }\n  .btn { background: var(--blue); color: white; border: 0; border-radius: 12px; padding: 11px 16px; font-weight: 750; cursor: pointer; }\n  .btn:hover { filter: brightness(.94); }\n  .btn.secondary { color: var(--blue); background: var(--blue-soft); }\n  .result { min-height: 48px; margin-top: 12px; padding: 12px 14px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; }\n  .type-card { position: relative; overflow: hidden; }\n  .type-card::before { content: \"\"; position: absolute; height: 5px; left: 0; top: 0; right: 0; background: var(--accent); }\n  .type-card.int { --accent: var(--blue); --tint: var(--blue-soft); }\n  .type-card.float { --accent: var(--green); --tint: var(--green-soft); }\n  .type-card.str { --accent: var(--purple); --tint: var(--purple-soft); }\n  .type-name { display: inline-block; color: var(--accent); background: var(--tint); border-radius: 10px; padding: 5px 10px; font-weight: 900; margin-bottom: 10px; }\n  .example { font-family: Consolas, \"Courier New\", monospace; background: #172338; color: #eef4ff; border-radius: 12px; padding: 12px 14px; overflow-wrap: anywhere; }\n  .example .comment { color: #a9bbd6; }\n  .type-card p { color: var(--muted); margin: 8px 0 14px; }\n  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }\n  .compare-item { border-radius: 15px; padding: 16px; border: 1px solid var(--line); }\n  .compare-item .big { font: 800 1.8rem Consolas, monospace; margin: 5px 0; }\n  .compare-item.number { background: var(--blue-soft); border-color: #cfddff; }\n  .compare-item.text { background: var(--purple-soft); border-color: #e0d0ff; }\n  .label-small { color: var(--muted); font-size: .88rem; }\n  .variable-visual { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 8px 0 4px; }\n  .box-label { width: min(100%, 280px); padding: 11px; text-align: center; border-radius: 13px; background: var(--blue-soft); color: #2449b8; font-weight: 850; }\n  .arrow { color: #8090aa; font-size: 1.6rem; line-height: 1; }\n  .box-value { width: min(100%, 280px); padding: 18px; text-align: center; border: 2px solid #8baaff; border-radius: 18px; background: white; }\n  .box-value strong { font-size: 2rem; color: var(--blue); display: block; }\n  .interactive-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }\n  input, select { font: inherit; }\n  .field { padding: 11px 13px; border: 1px solid #cfd9eb; border-radius: 12px; min-width: 0; background: white; }\n  .type-output { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 10px; }\n  .chip { border-radius: 999px; padding: 6px 11px; background: #edf2f8; font-weight: 750; font-size: .9rem; }\n  .chip.blue { background: var(--blue-soft); color: #2449b8; }\n  .chip.green { background: var(--green-soft); color: #116c49; }\n  .chip.purple { background: var(--purple-soft); color: #6d28d9; }\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }\n  .step { border: 1px solid var(--line); border-radius: 15px; padding: 15px; background: #fbfcff; }\n  .step b { display: block; margin-bottom: 5px; }\n  .step span { color: var(--muted); font-size: .92rem; }\n  .code-output { white-space: pre-wrap; min-height: 50px; }\n  .footer { text-align: center; color: var(--muted); padding: 14px 0 0; font-size: .9rem; }\n  @media (max-width: 760px) {\n    .grid, .grid.three { grid-template-columns: 1fr; }\n    .digits { grid-template-columns: repeat(5, minmax(0, 1fr)); }\n    .steps { grid-template-columns: 1fr; }\n    .card { padding: 17px; }\n  }\n  @media (max-width: 420px) {\n    .compare { grid-template-columns: 1fr; }\n    .hero { padding-top: 34px; }\n  }\n</style>\n</head>\n<body>\n<header class=\"hero\">\n  <div class=\"hero-inner\">\n    <div class=\"eyebrow\">Информатика · занятие 2</div>\n    <h1>Цифры, числа<br>и типы данных</h1>\n    <p>Разберёмся, как компьютер понимает числа и текст, что такое переменная и как Python работает с разными видами информации.</p>\n    <div class=\"hero-pills\">\n      <span>🔢 Цифры и числа</span><span>📦 Переменные</span><span>🧩 Типы данных</span><span>💻 Python</span>\n    </div>\n  </div>\n</header>\n\n<main>\n  <section class=\"section\" id=\"digits\">\n    <div class=\"section-head\"><div class=\"num\">1</div><div><h2>Цифры и числа</h2><p class=\"sub\">Цифры — это знаки, с помощью которых мы записываем числа.</p></div></div>\n    <div class=\"card\">\n      <p>В обычной десятичной системе всего <b>10 цифр</b>: от 0 до 9. Из них можно составить много разных чисел. Например, число 148 состоит из цифр 1, 4 и 8.</p>\n      <div class=\"digits\" id=\"digitButtons\" aria-label=\"Выбери цифру\"></div>\n      <div class=\"notice\" id=\"digitInfo\" aria-live=\"polite\">Нажми на любую цифру — посмотрим, как она используется.</div>\n      <h3 style=\"margin-top:22px\">Собери число</h3>\n      <p class=\"sub\">Введи целое число и нажми кнопку.</p>\n      <div class=\"number-builder\">\n        <input id=\"numberInput\" type=\"text\" inputmode=\"numeric\" value=\"148\" aria-label=\"Введи число\" maxlength=\"18\">\n        <button class=\"btn\" id=\"analyzeNumber\">Разобрать число</button>\n      </div>\n      <div class=\"result\" id=\"numberResult\" aria-live=\"polite\">Число 148 состоит из трёх цифр: 1, 4 и 8.</div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"types\">\n    <div class=\"section-head\"><div class=\"num\">2</div><div><h2>Что такое типы данных?</h2><p class=\"sub\">Тип данных показывает, какую информацию хранит программа.</p></div></div>\n    <div class=\"grid three\">\n      <article class=\"card type-card int\">\n        <span class=\"type-name\">int</span><h3>Целые числа</h3>\n        <p>Числа без дробной части.</p>\n        <div class=\"example\">age = 10<br>score = -3</div>\n        <p>Например: количество учеников, число яблок, этаж.</p>\n      </article>\n      <article class=\"card type-card float\">\n        <span class=\"type-name\">float</span><h3>Дробные числа</h3>\n        <p>Числа, у которых есть дробная часть. В Python пишем точку.</p>\n        <div class=\"example\">height = 1.7<br>price = 2.5</div>\n        <p>Например: рост, масса или температура.</p>\n      </article>\n      <article class=\"card type-card str\">\n        <span class=\"type-name\">str</span><h3>Строки — текст</h3>\n        <p>Буквы, слова и другие символы в кавычках.</p>\n        <div class=\"example\">name = \"Маша\"<br>code = \"123\"</div>\n        <p>Например: имя, сообщение или номер, который нужно хранить как текст.</p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"difference\">\n    <div class=\"section-head\"><div class=\"num\">3</div><div><h2>Число 123 и текст \"123\" — не одно и то же</h2><p class=\"sub\">Внешне они похожи, но компьютер обращается с ними по-разному.</p></div></div>\n    <div class=\"card\">\n      <div class=\"compare\">\n        <div class=\"compare-item number\"><span class=\"chip blue\">int</span><div class=\"big\">123</div><b>Это число</b><div class=\"label-small\">Можно выполнять математические действия.</div></div>\n        <div class=\"compare-item text\"><span class=\"chip purple\">str</span><div class=\"big\">\"123\"</div><b>Это текст</b><div class=\"label-small\">Это символы «1», «2» и «3» в кавычках.</div></div>\n      </div>\n      <h3 style=\"margin-top:22px\">Попробуй сложить</h3>\n      <p class=\"sub\">Выбери действие, чтобы увидеть разницу.</p>\n      <div class=\"interactive-row\" style=\"margin-top:12px\">\n        <button class=\"btn\" data-demo=\"numbers\">123 + 7</button>\n        <button class=\"btn secondary\" data-demo=\"strings\">\"123\" + \"7\"</button>\n      </div>\n      <div class=\"result code-output\" id=\"additionResult\" aria-live=\"polite\">Нажми на одну из кнопок.</div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"variables\">\n    <div class=\"section-head\"><div class=\"num\">4</div><div><h2>Что такое переменная?</h2><p class=\"sub\">Переменная — это именованное место, в котором программа хранит значение.</p></div></div>\n    <div class=\"grid\">\n      <div class=\"card\">\n        <p>Представь коробку с наклейкой. На наклейке написано имя, а внутри лежит значение.</p>\n        <div class=\"example\">age = 11<br>print(age)</div>\n        <div class=\"steps\">\n          <div class=\"step\"><b>age</b><span>Имя переменной — название коробки.</span></div>\n          <div class=\"step\"><b>=</b><span>Присваивание — положить значение в переменную.</span></div>\n          <div class=\"step\"><b>11</b><span>Значение, которое хранится внутри.</span></div>\n        </div>\n      </div>\n      <div class=\"card\">\n        <h3>Измени значение в коробке</h3>\n        <div class=\"variable-visual\">\n          <div class=\"box-label\" id=\"varLabel\">age</div><div class=\"arrow\">↓</div>\n          <div class=\"box-value\"><strong id=\"varValue\">11</strong><span class=\"label-small\" id=\"varType\">тип: int</span></div>\n        </div>\n        <div class=\"interactive-row\" style=\"margin-top:14px\">\n          <input class=\"field\" id=\"varInput\" value=\"11\" aria-label=\"Новое значение переменной\" style=\"width:100%\">\n          <button class=\"btn\" id=\"saveVariable\">Сохранить</button>\n        </div>\n        <div class=\"label-small\" style=\"margin-top:8px\">Если ввести слово, оно будет текстом. Если ввести число с точкой — дробным числом.</div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"type-check\">\n    <div class=\"section-head\"><div class=\"num\">5</div><div><h2>Как узнать тип данных?</h2><p class=\"sub\">В Python для этого есть команда <code>type()</code>.</p></div></div>\n    <div class=\"card\">\n      <div class=\"example\">print(type(10))<br>print(type(2.5))<br>print(type(\"Привет\"))</div>\n      <p>Результат показывает, какой тип у каждого значения: <b>int</b>, <b>float</b> или <b>str</b>.</p>\n      <h3>Проверь любое значение</h3>\n      <div class=\"interactive-row\">\n        <input class=\"field\" id=\"typeInput\" value=\"2.5\" aria-label=\"Значение для определения типа\">\n        <button class=\"btn\" id=\"checkType\">Узнать тип</button>\n      </div>\n      <div class=\"type-output\" id=\"typeResult\" aria-live=\"polite\"><span class=\"chip green\">float</span><span>2.5 — дробное число</span></div>\n      <p class=\"label-small\">Подсказка: текст нужно взять в кавычки, например \"кот\". Десятичная часть числа отделяется точкой.</p>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"operations\">\n    <div class=\"section-head\"><div class=\"num\">6</div><div><h2>Действия с данными</h2><p class=\"sub\">С числами Python считает, а строки может соединять.</p></div></div>\n    <div class=\"grid\">\n      <div class=\"card\">\n        <h3>Математические знаки</h3>\n        <div class=\"example\">10 + 5  →  15<br>10 - 5  →  5<br>10 * 5  →  50<br>10 / 5  →  2.0</div>\n        <p class=\"label-small\">В Python для умножения используют *, а для деления — /.</p>\n      </div>\n      <div class=\"card\">\n        <h3>Соединение текста</h3>\n        <div class=\"example\">\"Привет, \" + \"мир!\"<br>→ \"Привет, мир!\"</div>\n        <p>Знак <b>+</b> соединяет строки. Но число и текст нельзя просто так складывать:</p>\n        <div class=\"example\">5 + \"3\"  →  ошибка</div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"convert\">\n    <div class=\"section-head\"><div class=\"num\">7</div><div><h2>Как превратить текст в число?</h2><p class=\"sub\">Для этого используют команды преобразования типов.</p></div></div>\n    <div class=\"card\">\n      <div class=\"grid three\">\n        <div><span class=\"type-name\" style=\"color:#2449b8;background:var(--blue-soft)\">int()</span><p>Преобразует подходящее значение в целое число.</p><div class=\"example\">int(\"5\") → 5</div></div>\n        <div><span class=\"type-name\" style=\"color:#116c49;background:var(--green-soft)\">float()</span><p>Преобразует подходящее значение в дробное число.</p><div class=\"example\">float(\"2.5\") → 2.5</div></div>\n        <div><span class=\"type-name\" style=\"color:#6d28d9;background:var(--purple-soft)\">str()</span><p>Превращает значение в текст.</p><div class=\"example\">str(123) → \"123\"</div></div>\n      </div>\n      <h3 style=\"margin-top:24px\">Посмотри, как работает преобразование</h3>\n      <div class=\"interactive-row\">\n        <select class=\"field\" id=\"convertMode\" aria-label=\"Выбери преобразование\">\n          <option value=\"int\">int(\"5\")</option>\n          <option value=\"float\">float(\"2.5\")</option>\n          <option value=\"str\">str(123)</option>\n        </select>\n        <button class=\"btn\" id=\"convertButton\">Преобразовать</button>\n      </div>\n      <div class=\"result\" id=\"convertResult\" aria-live=\"polite\">Нажми «Преобразовать», чтобы увидеть результат.</div>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"section-head\"><div class=\"num\">✓</div><div><h2>Главное, что нужно запомнить</h2><p class=\"sub\">Короткая памятка по теме.</p></div></div>\n    <div class=\"card\">\n      <div class=\"grid\">\n        <div><span class=\"chip blue\">int</span> — целые числа: <code>15</code></div>\n        <div><span class=\"chip green\">float</span> — дробные числа: <code>2.5</code></div>\n        <div><span class=\"chip purple\">str</span> — текст в кавычках: <code>\"Привет\"</code></div>\n        <div><span class=\"chip\">type()</span> — узнаёт тип данных.</div>\n        <div><span class=\"chip\">name = value</span> — сохраняет значение в переменную.</div>\n        <div><span class=\"chip\">int(), float(), str()</span> — преобразуют тип данных.</div>\n      </div>\n    </div>\n  </section>\n  <div class=\"footer\">Интерактивный конспект · Python для начинающих</div>\n</main>\n\n<script>\n  const digitButtons = document.getElementById('digitButtons');\n  const digitInfo = document.getElementById('digitInfo');\n  for (let i = 0; i <= 9; i++) {\n    const button = document.createElement('button');\n    button.className = 'digit';\n    button.textContent = i;\n    button.setAttribute('aria-label', 'Цифра ' + i);\n    button.addEventListener('click', () => {\n      document.querySelectorAll('.digit').forEach(b => b.classList.remove('active'));\n      button.classList.add('active');\n      digitInfo.innerHTML = '<b>Цифра ' + i + '</b> — один из десяти знаков, из которых составляют числа. Например, число <b>' + i + '</b> записано одной цифрой.';\n    });\n    digitButtons.appendChild(button);\n  }\n\n  document.getElementById('analyzeNumber').addEventListener('click', () => {\n    const raw = document.getElementById('numberInput').value.trim();\n    const output = document.getElementById('numberResult');\n    if (!/^-?\\d+$/.test(raw)) {\n      output.textContent = 'Введи целое число, например 148 или -27. Не используй буквы и дробную точку.';\n      return;\n    }\n    const digits = raw.replace('-', '').split('');\n    const sign = raw.startsWith('-') ? 'Число отрицательное. ' : '';\n    output.innerHTML = sign + 'В числе <b>' + raw + '</b> ' + digits.length + ' ' +\n      (digits.length === 1 ? 'цифра' : (digits.length >= 2 && digits.length <= 4 ? 'цифры' : 'цифр')) +\n      ': <b>' + digits.join(', ') + '</b>.';\n  });\n\n  document.querySelectorAll('[data-demo]').forEach(button => {\n    button.addEventListener('click', () => {\n      const out = document.getElementById('additionResult');\n      if (button.dataset.demo === 'numbers') {\n        out.textContent = '123 + 7 = 130. Python складывает два числа.';\n      } else {\n        out.textContent = '\"123\" + \"7\" = \"1237\". Python соединяет две строки, а не складывает числа.';\n      }\n    });\n  });\n\n  function detectValue(raw) {\n    const value = raw.trim();\n    if (/^\".*\"$/.test(value) || /^'.*'$/.test(value)) return {type:'str', description:'текст в кавычках', value:value.slice(1,-1), color:'purple'};\n    if (/^-?\\d+$/.test(value)) return {type:'int', description:'целое число', value:value, color:'blue'};\n    if (/^-?\\d+\\.\\d+$/.test(value)) return {type:'float', description:'дробное число', value:value, color:'green'};\n    return {type:'str', description:'текст (если записан без кавычек в этом примере, считаем его текстом)', value:value, color:'purple'};\n  }\n\n  function updateVariable() {\n    const raw = document.getElementById('varInput').value.trim();\n    const detected = detectValue(raw);\n    document.getElementById('varValue').textContent = raw || '(пусто)';\n    document.getElementById('varType').textContent = 'тип: ' + detected.type;\n    document.getElementById('varLabel').textContent = 'my_variable';\n  }\n  document.getElementById('saveVariable').addEventListener('click', updateVariable);\n  document.getElementById('varInput').addEventListener('keydown', e => { if (e.key === 'Enter') updateVariable(); });\n\n  function showType() {\n    const raw = document.getElementById('typeInput').value.trim();\n    const out = document.getElementById('typeResult');\n    if (!raw) { out.textContent = 'Введи значение для проверки.'; return; }\n    const detected = detectValue(raw);\n    const shown = detected.type === 'str' && !(/^\".*\"$/.test(raw) || /^'.*'$/.test(raw)) ? '\"' + raw + '\"' : raw;\n    out.innerHTML = '<span class=\"chip ' + detected.color + '\">' + detected.type + '</span><span><b>' + escapeHtml(shown) + '</b> — ' + detected.description + '</span>';\n  }\n  function escapeHtml(s) {\n    return s.replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n  }\n  document.getElementById('checkType').addEventListener('click', showType);\n  document.getElementById('typeInput').addEventListener('keydown', e => { if (e.key === 'Enter') showType(); });\n\n  document.getElementById('convertButton').addEventListener('click', () => {\n    const mode = document.getElementById('convertMode').value;\n    const out = document.getElementById('convertResult');\n    const messages = {\n      int: '<b>int(\"5\") → 5</b><br>Текст \"5\" превратился в целое число 5.',\n      float: '<b>float(\"2.5\") → 2.5</b><br>Текст \"2.5\" превратился в дробное число.',\n      str: '<b>str(123) → \"123\"</b><br>Число 123 превратилось в текст.'\n    };\n    out.innerHTML = messages[mode];\n  });\n<\/script>\n</body>\n</html>\n";
